# channels/example.env — TEMPLATE ONLY. No real values live in the repo.
#
# On the VPS, each channel gets its own file:
#
#   /etc/albunyaan/relay-<channel>.env      (owner root:root, mode 600)
#
# where <channel> is the systemd instance name: lowercase [a-z0-9-] only.
# Planned channels (names double as instance names):
#
#   /etc/albunyaan/relay-basmah.env     -> systemctl enable --now relay@basmah
#   /etc/albunyaan/relay-rawdah.env     -> systemctl enable --now relay@rawdah
#   /etc/albunyaan/relay-<third>.env    -> confirm the 3rd channel's name with
#                                          the founder before creating this
#
# Values with spaces MUST be quoted. Lines are read by systemd
# (EnvironmentFile=) and, in local testing, sourced by bash — keep the syntax
# to simple KEY="value" pairs so both parsers agree.

# --- Identity ---------------------------------------------------------------
# Human-readable name (logs / dashboards). The machine name comes from the
# systemd instance (%i) and does not need to be set here.
CHANNEL_NAME="Basmah TV"

# --- Input: the third-party IPTV source (get from founder) -------------------
# HLS (.m3u8) or MPEG-TS over HTTP(S) both work; any ffmpeg-readable URL does.
SOURCE_URL="https://REPLACE-ME.example/iptv/basmah/index.m3u8"

# Some IPTV providers gate on User-Agent / Referer. Optional:
#USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
# Raw header lines, CRLF-separated. In bash tests use $'...\r\n'; in this
# systemd env file embed literal \r\n only if the provider requires multiple
# headers (single header needs no terminator handling in practice):
#HEADERS="Referer: https://provider.example/"

# Escape hatch for awkward sources (space-separated raw ffmpeg input flags):
#EXTRA_INPUT_ARGS="-probesize 10M -analyzeduration 10M"
# For RTSP sources: EXTRA_INPUT_ARGS="-rtsp_transport tcp"

# --- Output: pick EXACTLY ONE of the two targets ------------------------------
#
# (1) PRIMARY — Bunny Stream Live RTMP ingest (or any RTMP(S) endpoint).
#     Create the live stream in the Bunny panel first; paste ingest URL + key.
#     THE STREAM KEY IS A SECRET — this file is mode 600 for a reason, and
#     relay.sh never prints the URL (logs host only).
TARGET_RTMP_URL="rtmps://REPLACE-ME.bunny.example/live/REPLACE-STREAM-KEY"

# (2) FALLBACK — VPS packages HLS itself; nginx + Bunny CDN pull zone serve it.
#     Use only if Bunny Stream Live is unavailable/unsuitable (see README,
#     "Bunny live availability — verify first"). Directory per channel:
#HLS_OUT_DIR="/var/hls/basmah"

# --- Codec profile ------------------------------------------------------------
# Default is stream copy (no transcode, ~0 CPU). Set TRANSCODE=1 only if the
# source is not H.264+AAC or copy produces a broken stream. ~1 CPU core per
# channel at veryfast; size the VPS accordingly.
#TRANSCODE=1
#VIDEO_BITRATE="2500k"
#AUDIO_BITRATE="128k"
